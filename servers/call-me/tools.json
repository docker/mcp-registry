[
  {
    "name": "setup",
    "description": "Return first-setup instructions and the App Store link for the /call-me iPhone app"
  },
  {
    "name": "call",
    "description": "Ring the human's iPhone, read the text aloud and return their spoken answer",
    "arguments": [
      {
        "name": "question",
        "type": "string",
        "desc": "Text to read aloud",
        "required": true
      },
      {
        "name": "to",
        "type": "string",
        "desc": "10-digit /call-me number",
        "required": false
      },
      {
        "name": "from_label",
        "type": "string",
        "desc": "Caller name shown on the phone",
        "required": false
      }
    ]
  },
  {
    "name": "poll_result",
    "description": "Check on a call that was still ringing or in progress and return its transcript",
    "arguments": [
      {
        "name": "call_id",
        "type": "integer",
        "desc": "Call id returned by call",
        "required": true
      },
      {
        "name": "session_token",
        "type": "string",
        "desc": "Session token returned by call",
        "required": true
      }
    ]
  },
  {
    "name": "text",
    "description": "Send a one-way text to the human's phone",
    "arguments": [
      {
        "name": "body",
        "type": "string",
        "desc": "Message text",
        "required": true
      },
      {
        "name": "to",
        "type": "string",
        "desc": "10-digit /call-me number",
        "required": false
      },
      {
        "name": "from_label",
        "type": "string",
        "desc": "Sender name shown on the phone",
        "required": false
      }
    ]
  },
  {
    "name": "wait_for_reply",
    "description": "Wait for the human to text back or leave a voicemail",
    "arguments": [
      {
        "name": "session_token",
        "type": "string",
        "desc": "Session token",
        "required": true
      },
      {
        "name": "cursor",
        "type": "integer",
        "desc": "Event cursor",
        "required": false
      },
      {
        "name": "wait_s",
        "type": "integer",
        "desc": "Seconds to wait, max 30",
        "required": false
      }
    ]
  },
  {
    "name": "set_thread_title",
    "description": "Name this session's conversation thread on the phone",
    "arguments": [
      {
        "name": "session_token",
        "type": "string",
        "desc": "Session token",
        "required": true
      },
      {
        "name": "title",
        "type": "string",
        "desc": "Thread title",
        "required": true
      }
    ]
  }
]
