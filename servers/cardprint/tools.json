[
  {
    "name": "screen_deck",
    "description": "Screen a list of Pokemon TCG set marks for Standard-format legality and score each card's rotation risk on a seeded 0-100 scale.",
    "arguments": [
      {
        "name": "marks",
        "type": "array",
        "items": {
          "type": "string"
        },
        "desc": "Set marks to screen, e.g. [\"A\",\"E\",\"H\"]"
      },
      {
        "name": "seed",
        "type": "number",
        "desc": "Deterministic seed, default 2026",
        "optional": true
      }
    ]
  }
]
