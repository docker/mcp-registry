        "type": "string",
        "desc": "Ticker",
        "optional": true
      },
      {
        "name": "city_or_state",
        "type": "array",
        "desc": "City or state",
        "optional": true,
        "items": {
          "type": "string"
        }
      },
      {
        "name": "include_provenance",
        "type": "boolean",
        "desc": "Include source metadata where available.",
        "optional": true
